// Per family, once: both decode pipelines of the family (each passed its own self-test, DM_GFX_BC_SELFTEST).
bool family_ok(int f){
    if(fam[f]>=0)return fam[f]!=0;
    const uint32_t lin=xbg_bc_astc_linear(f),srgb=xbg_bc_astc_srgb(f);const VkPipeline a=bcgpu::pipeline(lin,0),b=bcgpu::pipeline(srgb,0);
    fam[f]=a && b?1:0;
    xbg_logf("NVN BC astc: %s (fmt %#x / %#x) -> %s",xbg_bc_astc_family_name(f),lin,srgb,fam[f]?"ASTC 4x4 (GPU decode + GPU encode)":!a?"RGBA8: its decode pipeline failed (CPU decode)":"RGBA8: the sRGB decode pipeline failed (CPU decode)");
    return fam[f]!=0;
}
// At image creation, for a texture bc_store decided to decode (not a DM_GFX_ASTC_CPU substitute): its ASTC format, or VK_FORMAT_UNDEFINED.
VkFormat image_format(const tex_t *t,VkSampleCountFlagBits samples){
    init_switches();
    if(!tried){tried=true;ok=prepare();
        if(ok)snprintf(pc_text,sizeof pc_text,"GPU-decoded BC1 / BC2 / BC3 / BC7 stored as ASTC 4x4 (DM_GFX_BC_ASTC=%s, self-test %u blocks ok, %d candidates; FN-60 / FN-61)",
            mode==2?"1":"auto",unsigned(XBG_BC_ASTC_KAT_N),cands);
        else snprintf(pc_text,sizeof pc_text,"%s",why);
        if(!ok)xbg_logf("NVN BC astc: off: %s",why);}
    const int f=xbg_bc_astc_family(t->d.format);
    if(f<0 || !ok || !family_ok(f))return VK_FORMAT_UNDEFINED;
    const VkFormat vf=xbg_bc_astc_vk_format(t->d.format);
    const char *keep=xbg_bc_astc_shape(t->d.format,t->d.target,t->d.width,t->d.height,t->d.levels,t->L.layers,int(samples),uint32_t(t->d.flags),vt);
    if(!keep){VkImageFormatProperties q{};VkImageCreateFlags fl=(!no_mutable_images?VK_IMAGE_CREATE_MUTABLE_FORMAT_BIT:0u)|(t->d.target==8 || t->d.target==9?VK_IMAGE_CREATE_CUBE_COMPATIBLE_BIT:0u);
        const VkResult r=vkGetPhysicalDeviceImageFormatProperties(cfg.physical,vf,VK_IMAGE_TYPE_2D,VK_IMAGE_TILING_OPTIMAL,VK_IMAGE_USAGE_SAMPLED_BIT|VK_IMAGE_USAGE_TRANSFER_SRC_BIT|VK_IMAGE_USAGE_TRANSFER_DST_BIT,fl,&q);
        if(r!=VK_SUCCESS || q.maxExtent.width<t->d.width || q.maxExtent.height<t->d.height || q.maxMipLevels<t->d.levels || q.maxArrayLayers<t->L.layers)keep="image format properties";}
    if(keep){++kept;static unsigned told=0;
        if(told++<24)xbg_logf("NVN BC astc: kept RGBA8 serial=%llu fmt=%#x target=%d %ux%u levels=%u layers=%u flags=%#x (%s)",
            (unsigned long long)t->serial,t->d.format,t->d.target,t->d.width,t->d.height,t->d.levels,t->L.layers,unsigned(t->d.flags),keep);
        return VK_FORMAT_UNDEFINED;}
    return vf;
}
// After vkCreateImage of an ASTC image: run counts; a line at 1, 2, 4, ... images.
void note_image(const Image &im,const tex_t *t){
    ++images;img_bytes+=uint64_t(im.mem_bytes);uint64_t rgba=0;
    for(uint32_t l=0;l<im.levels;l++)rgba+=uint64_t((std::max(1u,im.width>>l)+3)&~3u)*((std::max(1u,im.height>>l)+3)&~3u)*4*im.layers;
    rgba_bytes+=rgba;
    if(images&(images-1))return;
    xbg_logf("NVN BC astc: images=%llu created %.1fMB (RGBA8 would be %.1fMB) kept_rgba8=%llu batches=%llu blocks=%llu last serial=%llu fmt=%#x %ux%u levels=%u layers=%u vk=%d",
        (unsigned long long)images,img_bytes/1048576.0,rgba_bytes/1048576.0,(unsigned long long)kept,(unsigned long long)batches,(unsigned long long)blocks,
        (unsigned long long)t->serial,t->d.format,im.width,im.height,im.levels,im.layers,int(im.fmt));
}
// The [pc] line's text once its verdict is known: native BC (nothing to encode) or the encoder's state at the first decoded texture.
const char *report(int store,int *on){
    if(pc_done)return nullptr;
    if(store==BC_NATIVE){pc_done=true;*on=0;return "the device samples BC: no GPU decode path, nothing to encode";}
    if(store!=BC_DECODED || !tried)return nullptr;
    pc_done=true;*on=ok;return pc_text;
}
// CopyBufferToTexture into a GPU-written ASTC image (copy_texture_buffer: the CPU decode it would take writes RGBA8): the source blocks
// through BcUpload (GPU decode + encode), slice by slice for arrays, in one region for 3D.
void copy_from_buffer(Image &im,const tex_t *t,uint32_t level,uint32_t layer,const NVNcopyRegion &r,const uint8_t *src,size_t row,size_t image){
    int bw=4,bh=4;const size_t bb=size_t(nvn_fmt_bpb(t->d.format,&bw,&bh));const uint32_t nbx=(uint32_t(r.width)+3)/4,nby=(uint32_t(r.height)+3)/4,nz=uint32_t(r.depth);
    const bool volume=im.source.d.target==2;BcUpload up(im,t,false);up.partial=true;std::vector<uint8_t> raw;
    auto pack=[&](uint32_t k,uint8_t *o){for(uint32_t y=0;y<nby;y++)memcpy(o+size_t(y)*nbx*bb,src+size_t(k)*image+size_t(y)*row,size_t(nbx)*bb);};
    if(volume){raw.resize(size_t(nbx)*nby*nz*bb);for(uint32_t k=0;k<nz;k++)pack(k,raw.data()+size_t(k)*nbx*nby*bb);
        up.blocks(level,0,raw.data(),nbx,nby,nz,r.xoffset,r.yoffset,r.zoffset,uint32_t(r.width),uint32_t(r.height),nz);}
    else{raw.resize(size_t(nbx)*nby*bb);for(uint32_t k=0;k<nz;k++){pack(k,raw.data());up.blocks(level,layer+uint32_t(r.zoffset)+k,raw.data(),nbx,nby,1,r.xoffset,r.yoffset,0,uint32_t(r.width),uint32_t(r.height),1);}}
    up.finish(false);++buffer_uploads;
    static unsigned told=0;if(told++<8)xbg_logf("NVN BC astc: CopyBufferToTexture serial=%llu fmt=%#x level=%u layer=%u region=%d,%d,%d %dx%dx%d through the GPU encoder (batches=%u)",
        (unsigned long long)t->serial,t->d.format,level,layer,r.xoffset,r.yoffset,r.zoffset,r.width,r.height,r.depth,up.batches);
}
// copy_texture with an ASTC image on either side: 0 = the old checks and copy, 1 = an ASTC 4x4 texture of the same format into an ASTC
// image (the ASTC pack: blocks as they are), 2 = skipped (ASTC and RGBA8 of one family, or a mismatched format: logged).
int copy_route(const Image &s,const Image &d){
    if(!s.bc_astc && !d.bc_astc)return 0;
    if(s.bc_astc && d.bc_astc)return 0;   // same family (or the old fatal check): block copy
    if(d.bc_astc && !s.decoded && s.fmt==d.fmt){++block_copies;return 1;}
    ++copies_skipped;static unsigned told=0;if(told++<16)xbg_logf("NVN BC astc: copy skipped src=%llu fmt=%#x vk=%d -> dst=%llu fmt=%#x vk=%d (ASTC-stored and RGBA8 texels do not mix; total %llu)",
        (unsigned long long)s.source.serial,s.source.d.format,int(s.fmt),(unsigned long long)d.source.serial,d.source.d.format,int(d.fmt),(unsigned long long)copies_skipped);
    return 2;
}
void clear_skipped(const Image &im){
    ++clears;static unsigned told=0;if(told++<8)xbg_logf("NVN BC astc: clear of ASTC-stored serial=%llu fmt=%#x skipped (compressed images cannot be cleared; total %llu)",
        (unsigned long long)im.source.serial,im.source.d.format,(unsigned long long)clears);
}
