// One encode dispatch over the blocks [first, end) of the batch in bcgpu's buffers (the decoder has written its RGBA8 output). Usable on its
// own after any bcgpu decode of a batch (make_job / bcgpu::record do the whole sequence).
void encode(VkCommandBuffer cmd,uint32_t regions,uint32_t first,uint32_t end,uint32_t flags,bool full){
    bcgpu::step_barrier(cmd,full,VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,VK_ACCESS_SHADER_WRITE_BIT,VK_ACCESS_SHADER_READ_BIT);   // decoder output -> encoder
    const uint32_t push[4]={regions,first,end,flags};
    XBG_BCA_CMD(BindPipeline)(cmd,VK_PIPELINE_BIND_POINT_COMPUTE,pipe);XBG_BCA_CMD(BindDescriptorSets)(cmd,VK_PIPELINE_BIND_POINT_COMPUTE,layout,0,1,&set,0,nullptr);
    XBG_BCA_CMD(PushConstants)(cmd,layout,VK_SHADER_STAGE_COMPUTE_BIT,0,sizeof(push),push);XBG_BCA_CMD(Dispatch)(cmd,(end-first+63)/64,1,1);
}
// bcgpu::record of an ASTC job, after the decode dispatch: encode, [hook] copy out, copy the blocks into the image (TRANSFER_DST_OPTIMAL).
void record(VkCommandBuffer cmd,const BcJob &j,bool full){
    encode(cmd,j.regions,0,j.blocks,j.astc_flags,full);
    bcgpu::step_barrier(cmd,full,VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,VK_PIPELINE_STAGE_TRANSFER_BIT,VK_ACCESS_SHADER_WRITE_BIT,VK_ACCESS_TRANSFER_READ_BIT);
    if(j.astc_out){const BcAstcOut &o=*j.astc_out;VkBufferCopy r{0,o.rb.offset,VkDeviceSize(o.blocks)*16};XBG_BCA_CMD(CopyBuffer)(cmd,astc_buf,o.rb.buffer,1,&r);   // [hook] sink
        bcgpu::step_barrier(cmd,full,VK_PIPELINE_STAGE_TRANSFER_BIT,VK_PIPELINE_STAGE_HOST_BIT,VK_ACCESS_TRANSFER_WRITE_BIT,VK_ACCESS_HOST_READ_BIT);}
    if(j.image && !j.copies.empty())XBG_BCA_CMD(CopyBufferToImage)(cmd,astc_buf,j.image,VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,uint32_t(j.copies.size()),j.copies.data());
    ++batches;blocks+=j.blocks;
}
// [hook] BcUpload::flush of an ASTC batch: with a sink, a readback of the batch's blocks, handed over when the slot retires. Off: one test.
void attach_out(BcJob &j,uint64_t serial,uint32_t fmt){
    if(!sink || !j.blocks)return;
    Slot &s=recording_slot();auto o=std::make_shared<BcAstcOut>();o->serial=serial;o->fmt=fmt;o->blocks=j.blocks;o->copies=j.copies;o->rb=s.readback.alloc(size_t(j.blocks)*16);
    j.astc_out=o;++sink_batches;Sink f=sink;void *u=sink_user;
    s.retire.handles.push_back([o,f,u]{o->rb.invalidate();f(u,o->serial,o->fmt,o->copies.data(),o->copies.size(),static_cast<const uint8_t*>(o->rb.mapped),size_t(o->blocks)*16);});
}
// A job for a batch staged in `staging` (input bytes of an XbgBcGpuBatch of NVN format fmt), no image: record it with bcgpu::record; the
// ASTC blocks end in astc_buf (and in a sink when attach_out is called on the job). For a caller outside the upload path.
[[maybe_unused]] BcJob make_job(const Buffer &staging,const XbgBcGpuBatch &batch,uint32_t fmt){
    xbg_bc_format info{};xbg_bc_format_info(fmt,&info);
    BcJob j{staging.buffer,staging.offset,VkDeviceSize(batch.input_bytes()),bcgpu::pipeline(fmt,0),uint32_t(batch.regions()),batch.blocks,info.bytes_per_pixel,info.bytes_per_block/4,VK_NULL_HANDLE,{}};
    j.astc=pipe;j.astc_flags=xbg_bc_astc_flags(fmt);return j;
}
VkPipeline pipeline(){return ok?pipe:VK_NULL_HANDLE;}
bool submit_wait(VkCommandBuffer cb){
    XBG_BCA_SYNC();   // D16: the record thread submits nothing meanwhile (and the present thread takes the queue lock), as bcgpu::selftest
    vkResetFences(cfg.device,1,&kat_fence);VkSubmitInfo si{VK_STRUCTURE_TYPE_SUBMIT_INFO};si.commandBufferCount=1;si.pCommandBuffers=&cb;VkResult r;
    r=XBG_BCA_SUBMIT(si,kat_fence);
    if(r==VK_SUCCESS)r=vkWaitForFences(cfg.device,1,&kat_fence,VK_TRUE,5000000000ull);
    if(r!=VK_SUCCESS)xbg_logf("NVN BC astc: self-test submission failed (VkResult %d)",int(r));
    return r==VK_SUCCESS;
}
